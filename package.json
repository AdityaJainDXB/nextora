{
  "name": "nextora",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/noto-sans-gujarati": "^0.4.2",
    "@expo-google-fonts/noto-sans-gurmukhi": "^0.4.1",
    "@expo-google-fonts/noto-sans-kannada": "^0.4.3",
    "@expo-google-fonts/noto-sans-malayalam": "^0.4.2",
    "@expo-google-fonts/noto-sans-sinhala": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/noto-sans-telugu": "^0.4.2",
    "@expo/html-elements": "^58.0.3",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "firebase": "^13.1.0",
    "i18next": "^26.5.12",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "voice-glow": "^0.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "^15.34.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "start:dev-client": "expo start --dev-client",
    "emulators": "firebase emulators:start --project demo-nextora --only auth,firestore",
    "start:local": "USE_EMULATORS=1 expo start --go",
    "start:demo": "APP_ENV=demo expo start --go --lan --port 8085",
    "demo:backend": "firebase emulators:start --project demo-nextora --only auth,firestore",
    "demo:seed": "tsx scripts/seedDemo.ts",
    "web:local": "USE_EMULATORS=1 expo start --web",
    "test": "firebase emulators:exec --project demo-nextora --only firestore \"vitest run\"",
    "seed:content": "tsx scripts/seedContent.ts",
    "deploy:rules": "npm test && firebase deploy --only firestore:rules,firestore:indexes",
    "setup:worker": "node scripts/worker/setup.mjs",
    "check:worker": "node scripts/worker/check.mjs",
    "test:worker": "npm --prefix worker test",
    "typecheck:worker": "tsc --noEmit -p worker",
    "seed:guides": "tsx scripts/seedGuides.ts",
    "seed:sample": "tsx scripts/seedSample.ts",
    "seed:remove": "tsx scripts/seedSample.ts --remove",
    "i18n:check": "node scripts/i18nCheck.mjs",
    "demo": "node scripts/demo.mjs",
    "deploy:web": "node scripts/deployWeb.mjs"
  },
  "private": true
}
